// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "markdown_preview": {
    
  },
  "proxy": "",
  "cursor_animation": {
    "enabled": true
  },
  "cli_default_open_behavior": "existing_window",
  "agent_ui_font_size": 32.0,
  "buffer_font_family": "Maple Mono NF CN",
  "icon_theme": "Zed (Default)",
  "ui_font_family": "LXGW Bright GB",
  "disable_ai": true,
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "dock": "left"
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false
  },
  "session": {
    "trust_all_worktrees": true
  },
  "ui_font_size": 16.0,
  "buffer_font_size": 15,
  "theme": "{{ if eq (get . "theme" | default "tokyonight") "tokyonight" }}Tokyo Night{{ else if eq (get . "theme" | default "tokyonight") "gruvbox-light" }}Gruvbox Light{{ else }}Gruvbox Dark Hard{{ end }}",
}
