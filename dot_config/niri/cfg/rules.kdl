window-rule {
    geometry-corner-radius 0
    clip-to-geometry false
    tiled-state true
    draw-border-with-background false
}

window-rule {
    background-effect {
      blur true
      xray false
    }
}

// noctalia setting
window-rule {
    match app-id=r"dev.noctalia.Noctalia"
    open-floating true
    // default-column-width { fixed 1080; }
    // default-window-height { fixed 920; }
}

layer-rule {
  match namespace="^noctalia-backdrop"
  place-within-backdrop true
}

layer-rule {
  match namespace="^noctalia-(bar-[^\"]+|notification|dock|panel|attached-panel|osd)$"
  background-effect {
    xray false
    // blur false
  }
}

layer-rule {
    match namespace="^noctalia-background-.*$"
    background-effect {
        blur false
    }
}

// window rules
// steam
window-rule {
    match app-id="steam"
    exclude title=r#"^[Ss]team$"#
    open-floating true
}

window-rule {
   match app-id="steam" title=r#"^notificationtoasts_\d+_desktop$"#
   default-floating-position x=10 y=10 relative-to="bottom-right"
   open-focused false
}

window-rule {
    match app-id=r#"^org\.gnome\.Calculator$"#
    match app-id=r#"^gnome-calculator$"#
    match app-id=r#"^xdg-desktop-portal$"#
    open-floating true
}

window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    match app-id="zoom"
    open-floating true
}

window-rule {
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    match app-id="Alacritty"
    match app-id="zen"
    match app-id="com.mitchellh.ghostty"
    match app-id="kitty"
    draw-border-with-background false
}

// --- custom rules ---
window-rule {
    match app-id="^Beeper$"
    open-focused false
    open-on-workspace "chat"
    open-maximized true
}

window-rule {
    match app-id="^steam$"
    match title="Steam"
    open-on-workspace "steam"
}

window-rule {
    match app-id="^com.obsproject.Studio$"
    match title="Projector"
    open-focused true
    open-on-workspace "main"
}

window-rule {
    match app-id="^com.obsproject.Studio$"
    exclude title="Projector"
    open-on-workspace "obs"
}

window-rule {
    match app-id="PrintTerminal"
    open-floating true
    default-column-width { fixed 600; }
    default-window-height { fixed 400; }
    default-floating-position x=50 y=400 relative-to="top-right"
}

// OnlyOffice Presenter View
window-rule {
    match app-id="^ONLYOFFICE$" title="\\.pptx"
    match app-id="^ONLYOFFICE$" title="\\.ppt"
    open-on-output "HDMI-A-1"
    open-focused false
    open-maximized true
}

// OnlyOffice save
window-rule {
    match app-id="^DesktopEditors$"
    match title="另存为"
    default-column-width { fixed 1366; }
    default-window-height { fixed 768; }
}
