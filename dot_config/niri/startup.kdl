// spawn-at-startup "sunshine"
// spawn-sh-at-startup "~/.local/bin/msige602pl-fix-audio" // for laptop
// spawn-at-startup "~/AppImages/beeper.appimage"

// Personal Workspaces
workspace "main"
workspace "steam"
workspace "obs"
