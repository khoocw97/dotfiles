// Colour
layout {
    background-color "transparent"
    // background-color "00000020"
    // 聚焦
    focus-ring {
        active-color "#b6c7e7"
        inactive-color "#131315"
        urgent-color "#ffb4ab"
    }
    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color "#b6c7e7"
        inactive-color "#374761"
        urgent-color "#ffb4ab"
    }

    insert-hint {
        color "#b6c7e780"
    }
}
